# ============================================================
# AgentBus 服务端环境变量（唯一配置入口，docker-compose.yml 注入）
# 用法：cp .env.example .env 后按注释填写
#
# 边界说明：
# - 本文件只管 hub 与 broker 的运行参数（docker-compose.yml 注入）；
#   broker 用户/ACL 由 dynsec 插件运行时管理（控制台账号体系），
#   TLS 证书由 scripts/setup-broker-security.ps1 生成，首次启动前先跑。
# - 客户端（agentbus CLI/daemon）不使用 .env：其接入配置在每个项目的
#   .agentbus/config.json，由 `agentbus init` 交互生成。
# ============================================================

# ── hub → broker 连接 ──────────────────────────────────────
# docker compose 内自动为 mqtt-broker，无需修改；本地直跑 hub 连外部 broker 时使用
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# 四期：compose 内 hub 改用 DYNSEC_ADMIN_* 凭证（见下）；
# 仅本地直跑 hub 连外部 broker 时才需填这两项
MQTT_USERNAME=
MQTT_PASSWORD=
# TLS：连 8883 时置 true；自签证书时 MQTT_CA_CERTS 必填（如 ./mosquitto/certs/ca.crt）
MQTT_USE_TLS=false
MQTT_CA_CERTS=

# ── hub 监听 ──────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── 控制台 / SSE 鉴权（TASK-25）────────────────────────────
# 非空即启用 token 鉴权（仅保护 MCP 通道 /sse、/messages/*；/health 始终开放；
# 控制台 API 走 session 登录鉴权，与此 token 互不影响）
# 建议生产环境必填强随机串；空=全开放（仅限本机调试）
MCP_API_TOKEN=

# ── 四期：账号体系 ────────────────────────────────────────────
# dynsec 管理员（broker 插件管理通道 + hub 连接凭证）
DYNSEC_ADMIN_USER=admin
DYNSEC_ADMIN_PASSWORD=请改成强密码
# 控制台首个超级管理员（users 表为空时自动创建）
AGENTBUS_ADMIN_USER=root
AGENTBUS_ADMIN_PASSWORD=请改成强密码
