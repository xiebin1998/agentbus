# ============================================================
# AgentBus 服务端环境变量（唯一配置入口，docker-compose.yml 注入）
# 用法：cp .env.example .env 后按注释填写
#
# 边界说明：
# - 本文件只管 hub 的运行参数；broker 自身的 passwd/acl/证书是文件型配置，
#   由 scripts/setup-broker-security.ps1 与 scripts/sync-broker-acl.ps1 生成
#   （mosquitto 不支持环境变量替换），首次启动前必须先跑 setup 脚本。
# - 客户端（agentbus CLI/daemon）不使用 .env：其接入配置在每个项目的
#   .agentbus/config.json，由 `agentbus init` 交互生成。
# ============================================================

# ── hub → broker 连接 ──────────────────────────────────────
# docker compose 内自动为 mqtt-broker，无需修改；本地直跑 hub 时填 broker 宿主地址
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# setup-broker-security.ps1 生成的 hub 账号（默认账号 agentbus，密码随机打印）
MQTT_USERNAME=
MQTT_PASSWORD=
# TLS：连 8883 时置 true；自签证书时 MQTT_CA_CERTS 必填（如 ./mosquitto/certs/ca.crt）
MQTT_USE_TLS=false
MQTT_CA_CERTS=

# ── hub 监听 ──────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ── 控制台 / SSE 鉴权（TASK-25）────────────────────────────
# 非空即启用 token 鉴权（保护 /sse、/messages/*、/console、/api/console/*；/health 始终开放）
# 建议生产环境必填强随机串；空=全开放（仅限本机调试）
MCP_API_TOKEN=
