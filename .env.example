# MQTT Broker 配置
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_USE_TLS=false
# TASK-25：自签 CA 证书路径（TLS + 自签证书时必填，如 ./mosquitto/certs/ca.crt）
MQTT_CA_CERTS=

# MCP Server 配置
MCP_HOST=0.0.0.0
MCP_PORT=8000
# TASK-25：SSE/控制台 token 鉴权（非空启用；/health 始终开放；空=全开放）
MCP_API_TOKEN=
